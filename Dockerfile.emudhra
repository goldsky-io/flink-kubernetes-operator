FROM 301417190815.dkr.ecr.us-west-2.amazonaws.com/flink-kubernetes-operator@sha256:1a5428ffdf2bc8561949da9e598ed567b6ea1fd7a605fe0f3251963b8c650881
USER root
# Remove the compromised test-chain anchor; AAA is already absent in this exact image.
RUN keytool -delete -cacerts -storepass changeit -alias 'cn=emsign_ecc_root_ca_-_g3,o=emudhra_technologies_limited,ou=emsign_pki,c=in'
USER flink
